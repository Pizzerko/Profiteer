# Copy to .env and adjust. All values have sane dev defaults in app/core/config.py.

# Postgres example (leave unset to use local SQLite):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/profiteer
DATABASE_URL=sqlite:///./profiteer.db

# CHANGE THIS for anything non-local. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me

ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
STARTING_CASH=100000
